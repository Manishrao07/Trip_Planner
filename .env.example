# Copy to .env.local and fill in. Never commit .env.local.
#
# Get a free key at https://aistudio.google.com/apikey
# This is read ONLY on the server (app/api/itinerary/route.ts). It is never
# exposed to the browser — note the deliberate absence of a NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash.
# Other good options: gemini-2.5-flash-lite (faster/cheaper), gemini-2.5-pro (slower/smarter).
GEMINI_MODEL=gemini-2.5-flash
